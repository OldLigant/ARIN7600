# Mimo API (for caption_pipeline.py)
# Get your key from https://www.xiaomimimo.com/
MIMO_API_KEY=your_mimo_api_key_here

# Mimo API base URL (default shown; change if using a different endpoint)
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# HuggingFace token (for download_video.py / download_egolifecap.py)
# The EgoLife dataset is public, so this is OPTIONAL — only needed if you hit
# rate limits or want access to gated related repos.
HF_TOKEN=your_huggingface_token_here
