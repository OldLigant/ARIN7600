# --- Secrets ---
.env

# --- Downloaded data (large, regenerable) ---
videos/
EgoLifeCap/

# --- HuggingFace cache ---
.cache/

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/

# --- Caption pipeline intermediate/cache outputs ---
# Keep only the main annotation jsonl; drop usage logs, run logs, summaries,
# and the re-encoded slice cache.
captions/**/_cache/
captions/**/*_usage.jsonl
captions/**/*_summary.json
captions/**/*_run.log
captions/**/*.log

# --- Test / scratch output (never commit experiments) ---
captions/**/_test/
captions/**/_archive_*/
out/_test/

# --- Drafts / scratch under tmp/ (design docs, prompt drafts, one-off scripts) ---
tmp/

# --- OS/editor ---
.DS_Store
Thumbs.db
*.swp
*~
